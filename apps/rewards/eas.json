{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" }
    },
    "simulator": {
      "extends": "preview",
      "ios": { "simulator": true }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": { "production": {} }
}
